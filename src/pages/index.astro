---
export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Professional subliminal audio editor with alpha and theta binaural beats" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Alpha-Theta Subliminal Audio Editor</title>
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="app">
      <!-- Toolbar -->
      <header class="toolbar">
        <div class="toolbar-left">
          <span class="logo">Alpha-Theta Subliminals</span>
        </div>
        <div class="toolbar-center">
          <div class="transport-controls">
            <button id="rewindBtn" class="transport-btn" title="Rewind">
              <svg viewBox="0 0 24 24"><path d="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z"/></svg>
            </button>
            <button id="playBtn" class="transport-btn play-btn" title="Play/Pause">
              <svg class="play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon hidden" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <button id="stopBtn" class="transport-btn" title="Stop">
              <svg viewBox="0 0 24 24"><path d="M6 6h12v12H6z"/></svg>
            </button>
            <button id="loopBtn" class="transport-btn" title="Loop">
              <svg viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
            </button>
          </div>
          <div class="time-display">
            <span id="currentTime">00:00:00</span>
            <span class="time-separator">/</span>
            <span id="totalTime">00:00:00</span>
          </div>
        </div>
        <div class="toolbar-right">
          <button id="zoomOutBtn" class="tool-btn" title="Zoom Out">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14zM7 9h5v1H7z"/></svg>
          </button>
          <button id="zoomInBtn" class="tool-btn" title="Zoom In">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14zm.5-7H9v2H7v1h2v2h1v-2h2V9h-2z"/></svg>
          </button>
          <button id="zoomFitBtn" class="tool-btn" title="Fit to Window">
            <svg viewBox="0 0 24 24"><path d="M3 5v4h2V5h4V3H5c-1.1 0-2 .9-2 2zm2 10H3v4c0 1.1.9 2 2 2h4v-2H5v-4zm14 4h-4v2h4c1.1 0 2-.9 2-2v-4h-2v4zm0-16h-4v2h4v4h2V5c0-1.1-.9-2-2-2z"/></svg>
          </button>
          <div class="toolbar-divider"></div>
          <button id="exportBtn" class="action-btn">
            <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            Export
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <div class="main-content">
        <!-- Left Sidebar - Sources Panel -->
        <aside class="sidebar sources-panel">
          <div class="panel-header">
            <h2>Audio Sources</h2>
          </div>

          <!-- Import Audio -->
          <div class="source-section">
            <h3>Import Audio</h3>
            <div id="dropZone" class="drop-zone">
              <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
              <span>Drop audio files here</span>
              <span class="drop-hint">or click to browse</span>
              <input type="file" id="fileInput" accept="audio/*" multiple hidden>
            </div>
          </div>

          <!-- Text-to-Speech -->
          <div class="source-section">
            <h3>Text-to-Speech</h3>
            <textarea id="ttsText" placeholder="Enter affirmations (one per line)..."></textarea>
            <div class="tts-controls">
              <label>
                <span>Voice:</span>
                <select id="ttsVoice"></select>
              </label>
              <label>
                <span>Speed:</span>
                <input type="range" id="ttsRate" min="0.5" max="2" step="0.1" value="1">
                <span id="ttsRateValue">1.0x</span>
              </label>
            </div>
            <button id="generateTtsBtn" class="source-btn">Generate TTS Audio</button>
          </div>

          <!-- Voice Recording -->
          <div class="source-section">
            <h3>Record Voice</h3>
            
            <!-- Recording Mode Toggle -->
            <div class="recording-mode-toggle">
              <button id="singleRecordMode" class="mode-btn active" data-mode="single">Single</button>
              <button id="multiRecordMode" class="mode-btn" data-mode="multi">Multi-Sentence</button>
            </div>

            <!-- Single Recording Mode -->
            <div id="singleRecordingPanel" class="recording-panel">
              <div class="record-controls">
                <button id="recordBtn" class="record-btn">
                  <span class="record-dot"></span>
                  <span id="recordLabel">Record</span>
                </button>
                <span id="recordTime" class="record-time hidden">00:00</span>
              </div>
            </div>

            <!-- Multi-Sentence Recording Mode -->
            <div id="multiRecordingPanel" class="recording-panel hidden">
              <textarea id="sentenceList" placeholder="Enter subliminal sentences (one per line)...

Example:
I am confident
I am successful
I attract abundance"></textarea>
              
              <div id="sentenceRecordingUI" class="sentence-recording-ui hidden">
                <div class="sentence-progress">
                  <span id="sentenceIndex">1</span> / <span id="sentenceTotal">0</span>
                </div>
                <div class="current-sentence-display">
                  <span class="label">Say:</span>
                  <p id="currentSentence"></p>
                </div>
                <div class="sentence-record-controls">
                  <button id="sentenceRecordBtn" class="record-btn">
                    <span class="record-dot"></span>
                    <span id="sentenceRecordLabel">Record</span>
                  </button>
                  <span id="sentenceRecordTime" class="record-time hidden">00:00</span>
                </div>
                <div class="sentence-actions hidden" id="sentenceActions">
                  <button id="reRecordBtn" class="action-btn secondary">Re-record</button>
                  <button id="acceptSentenceBtn" class="action-btn primary">Accept & Next</button>
                </div>
                <div class="recorded-sentences-list">
                  <span class="list-label">Recorded:</span>
                  <div id="recordedSentencesList"></div>
                </div>
              </div>
              
              <button id="startSentenceRecording" class="source-btn">Start Recording Session</button>
              <button id="finishSentenceRecording" class="source-btn primary hidden">Create Subliminal Tracks</button>
              <button id="cancelSentenceRecording" class="source-btn danger hidden">Cancel Session</button>
            </div>
          </div>

          <!-- Binaural Generator -->
          <div class="source-section">
            <h3>Binaural Beat Generator</h3>
            <div class="binaural-controls">
              <div class="wave-type-select">
                <button id="thetaBtn" class="wave-btn active" data-type="theta">
                  Theta (4-8 Hz)
                </button>
                <button id="alphaBtn" class="wave-btn" data-type="alpha">
                  Alpha (8-13 Hz)
                </button>
              </div>
              <label>
                <span>Frequency: <strong id="freqValue">6.0</strong> Hz</span>
                <input type="range" id="binauralFreq" min="4" max="8" step="0.5" value="6">
              </label>
              <label>
                <span>Base Tone: <strong id="baseFreqValue">200</strong> Hz</span>
                <input type="range" id="baseFreq" min="100" max="400" step="10" value="200">
              </label>
              <button id="addBinauralBtn" class="source-btn">Add Binaural Track</button>
            </div>
          </div>
        </aside>

        <!-- Center - Timeline -->
        <main class="timeline-container">
          <!-- Timeline Header with Time Ruler -->
          <div class="timeline-header">
            <div class="track-header-spacer"></div>
            <div class="time-ruler-container">
              <canvas id="timeRuler" class="time-ruler"></canvas>
            </div>
          </div>

          <!-- Tracks Container -->
          <div id="timelineTracks" class="timeline-tracks">
            <div id="emptyTimeline" class="empty-timeline">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
              <p>No tracks yet</p>
              <span>Import audio files, generate TTS, record your voice, or add binaural beats from the left panel</span>
            </div>
          </div>

          <!-- Timeline Scrollbar -->
          <div class="timeline-scrollbar">
            <div class="track-header-spacer"></div>
            <div class="scrollbar-track">
              <div id="scrollbarThumb" class="scrollbar-thumb"></div>
            </div>
          </div>
        </main>

        <!-- Right Sidebar - Properties Panel -->
        <aside class="sidebar properties-panel">
          <div class="panel-header">
            <h2>Track Properties</h2>
          </div>
          <div id="noSelection" class="no-selection">
            Select a track to edit its properties
          </div>
          <div id="trackProperties" class="track-properties hidden">
            <div class="property-group">
              <h4>General</h4>
              <label>
                <span>Track Name</span>
                <input type="text" id="trackName" class="property-input">
              </label>
              <label>
                <span>Volume</span>
                <input type="range" id="trackVolume" min="0" max="1" step="0.01" value="1">
                <span id="trackVolumeValue">100%</span>
              </label>
              <label>
                <span>Pan</span>
                <input type="range" id="trackPan" min="-1" max="1" step="0.01" value="0">
                <span id="trackPanValue">C</span>
              </label>
            </div>
            <div id="subliminalSettings" class="property-group">
              <h4>Repetition Settings</h4>
              <label>
                <span>Repetitions per Hour</span>
                <input type="number" id="repetitionsPerHour" class="property-input" min="1" max="1000" value="60">
              </label>
              <label class="checkbox-label">
                <input type="checkbox" id="randomizePosition" checked>
                <span>Randomize Position</span>
              </label>
              <label class="checkbox-label">
                <input type="checkbox" id="randomizeVolume" checked>
                <span>Randomize Volume (±20%)</span>
              </label>
              <label class="checkbox-label">
                <input type="checkbox" id="randomizePitch" checked>
                <span>Randomize Pitch (±5%)</span>
              </label>
            </div>
            <div class="property-group">
              <h4>Effects</h4>
              <label>
                <span>Fade In (seconds)</span>
                <input type="number" id="fadeIn" class="property-input" min="0" max="30" step="0.5" value="0">
              </label>
              <label>
                <span>Fade Out (seconds)</span>
                <input type="number" id="fadeOut" class="property-input" min="0" max="30" step="0.5" value="0">
              </label>
            </div>
            <div class="property-actions">
              <button id="duplicateTrackBtn" class="property-btn">Duplicate</button>
              <button id="deleteTrackBtn" class="property-btn danger">Delete</button>
            </div>
          </div>
        </aside>
      </div>

      <!-- Master Bar -->
      <footer class="master-bar">
        <div class="master-section">
          <span class="master-label">MASTER</span>
          <div class="master-meter">
            <div class="meter-bar"><div id="meterLeft" class="meter-fill"></div></div>
            <div class="meter-bar"><div id="meterRight" class="meter-fill"></div></div>
          </div>
          <input type="range" id="masterVolume" min="0" max="1" step="0.01" value="0.8" class="master-slider">
          <span id="masterVolumeValue" class="master-value">80%</span>
        </div>
        <div class="output-settings">
          <label>
            Duration:
            <select id="outputDuration">
              <option value="60">1 minute</option>
              <option value="300">5 minutes</option>
              <option value="600">10 minutes</option>
              <option value="900">15 minutes</option>
              <option value="1800">30 minutes</option>
              <option value="3600" selected>1 hour</option>
              <option value="7200">2 hours</option>
              <option value="14400">4 hours</option>
              <option value="28800">8 hours</option>
            </select>
          </label>
          <label>
            Format:
            <select id="outputFormat">
              <option value="wav">WAV (Lossless)</option>
              <option value="mp3">MP3 (Compressed)</option>
            </select>
          </label>
        </div>
      </footer>
    </div>

    <!-- Export Modal -->
    <div id="exportModal" class="modal hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Exporting Audio</h2>
          <button id="closeModalBtn" class="close-btn">&times;</button>
        </div>
        <div class="modal-body">
          <div id="exportProgress" class="export-progress">
            <div class="progress-bar">
              <div id="progressFill" class="progress-fill"></div>
            </div>
            <p id="exportStatus">Mixing audio tracks...</p>
          </div>
          <div id="exportComplete" class="export-complete hidden">
            <svg class="success-icon" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            <p>Export Complete!</p>
            <button id="downloadBtn" class="download-btn">Download Audio</button>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { initApp } from '../lib/app';
      initApp();
    </script>
  </body>
</html>
